# macro-scan（天枢）环境变量模板
# 最后更新：2026-09-10（开源实施计划 阶段 1，CHG-20260910T223700-world-deduction）
#
# 用法：复制为 .env 后填入真值；.env 不进 git（已被 .gitignore 覆盖）。
# 图例：[必需] 不配会导致系统起不来或核心功能失效
#       [可选] 不配只是对应数据源/特性跳过，不影响主流程
#
# 判据说明：本文件由全仓库 os.environ.get / os.getenv 扫描生成（78 个变量全覆盖），
#           「必需/可选」依据是否有 raise 阻断、是否为核心链路、是否为多数据源之一。

## ───────────────────────────────────────────
## 一、核心配置（必需）
## ───────────────────────────────────────────

# PostgreSQL 应用账号密码。天枢/天玑/天璇共用 worldsim 库，缺失则所有 DB 读写失败。
WORLDSIM_APP_PW=

# FRED（圣路易斯联储）API Key。宏观指标的主数据源，缺失则利率/就业/通胀等时序全部拉不到。
# 免费申请：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 硅基流动（SiliconFlow）API Key。LLM 主通道，用于叙事生成、假设评估、RAG 嵌入。
# 控制台：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# 控制台鉴权令牌（自定义随机串即可）。开阳面板与 control_server 的访问控制。
CONTROL_TOKEN=

# ntfy 告警频道名。手机订阅它接收系统推送。
# 建议 32 位以上随机串（如 tsx-alert-<随机>），避免被他人猜到后订阅你的告警。
NTFY_TOPIC=

# ntfy 命令频道名。手机向它发送指令（格式：<NTFY_CMD_SECRET> <指令>）。
# 必须与 NTFY_TOPIC 不同；缺失时 ntfy_listener 会直接退出。
NTFY_CMD_TOPIC=

# 命令频道的共享密钥，作为每条指令的首个词发送用于校验。
# 注意：该值会随指令明文出现在频道上，因此真正的安全边界是「频道名不可猜」，不是这个值本身。
NTFY_CMD_SECRET=

## ───────────────────────────────────────────
## 二、数据源凭证（可选，按需启用）
## 均为多数据源之一，缺失只影响对应采集模块，不影响主流程
## ───────────────────────────────────────────

# EIA（美国能源信息署）—— 能源库存与产量
EIA_API_KEY=

# NASA FIRMS —— 卫星火点/地缘热力
FIRMS_MAP_KEY=

# Space-Track —— 在轨卫星与轨道事件
SPACETRACK_ID=
SPACETRACK_PASS=

# CoinGecko —— 加密货币行情
COINGECKO_API_KEY=

# Marketaux —— 财经新闻
MARKETAUX_API_KEY=

# Currents API —— 新闻流
CURRENTS_API_KEY=

# AEMET —— 西班牙气象开放数据
AEMET_API_KEY=

# NREL —— 美国可再生能源实验室（光伏/能源）
NREL_API_KEY=

# 英国电网 ESO BMRS —— 电力与碳强度
NATIONAL_GRID_ESO_BMRS_KEY=

# SUGRA —— 观测数据源
SUGRA_API_KEY=

# 备用 LLM 通道（与硅基流动二选一或并存）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_URL=

## ───────────────────────────────────────────
## 三、代理与出网（按需）
## 外部使用者请留意：本系统原部署在内网环境，部分默认值指向私有代理，
## 在你自己的环境里应改为你的代理地址，或直接留空走直连。
## ───────────────────────────────────────────

# 统一出网代理（默认曾指向内网地址，请自行覆盖）
PROXY_URL=
OUTBOUND_PROXY=
HTTP_PROXY=
HTTPS_PROXY=

# 分数据源代理（不设则回退到上面的通用代理）
GDELT_PROXY=
FRED_PROXY=
NAS_PROXY_URL=

## ───────────────────────────────────────────
## 四、高级配置（一般无需修改）
## ───────────────────────────────────────────

# 端口
CONTROL_PORT=
AUTH_GATEWAY_PORT=
WEB_PORT=

# 数据库地址（默认 worldsim-pg:5432，容器网络内可达）
WORLDSIM_PG_HOST=
WORLDSIM_PG_PORT=

# 目录与数据路径（默认走容器内的 /app/data 等，一般不用改）
DATA_DIR=
WORLDSIM_DATA_DIR=
TIANJI_DATA_DIR=
FRED_HISTORY_DIR=
GRV_WEIGHTS_PATH=
WORLDSIM_SECRETS_PATH=
MACRO_SCAN_WORKDIR=

# 模型选择
SILICONFLOW_MODEL=
SILICONFLOW_EMBED_MODEL=
CLAUDE_MODEL=
VERIFY_LLM_MODEL=
LLM_AUTO_TIMEOUT=

# 功能开关与阈值
GRV_DRY_RUN=
STAGING_MODE=
TIANJI_LLM_PILOT=
WORLDSIM_SQLITE_OFF=
NEWS_TTL_DAYS=
REPORTS_TTL_DAYS=
NEWS_GEO_WINDOW_HOURS=
NEWS_GEO_MAX_EVENTS=
NEWS_GEO_MIN_MENTIONS=
NEWS_GEO_AGGREGATE=
DASHBOARD_OUTPUT=
D0_DATE=
TMPDIR=

# 数据源端点（多数已内置默认公网地址，仅私有部署/镜像源/自建服务时需要覆盖）
AEMET_BASE=
BINANCE_API_BASE=
CURRENTS_API_URL=
MARKETAUX_API_URL=
NREL_PVWATTS_URL=
SUGRA_API_URL=
USGS_EARTHQUAKE_URL=
HDX_API_BASE=
HDX_QUERY=
KRAKEN_API_BASE=
OPEN_SANCTIONS_DATA_URL=
RSSHUB_URL=
SAFECAST_BASE_URL=
UK_CARBON_INTENSITY_BASE=
NEODATA_HOST=
NTFY_BASE_URL=

# 外部数据集路径（如 GED 冲突数据 CSV）
GED_CSV_PATH=
GED_DATA_DIR=
