#!/bin/sh
# =============================================================
# world-sim pre-push 门禁（推前最后一道本地闸）
#
# 为什么需要它（pre-commit 覆盖不到）：
#   · pre-commit 只看 staged，而 push 推的是「本次推送的全部历史」
#   · 第 3 个 commit 里夹的密钥，pre-commit 那次可能没装，或被 --no-verify 绕过
#
# 扫描区间 = git 经 stdin 传入的「真实推送对象」（逐 ref 解析）。
#   不再硬编码 origin/main..HEAD —— 那是「本地领先量」的语义，
#   在推非 HEAD 分支 / --all / 多 ref 时会算错区间而静默漏扫。
#
# 零硬依赖：有 gitleaks 就用，没有则回退内建正则 —— 保证任何机器都生效
# 已知局限：本地 hook 可被 --no-verify 绕过 → 必须配 CI 与 GitHub Push protection
#
# 安装: git config core.hooksPath .githooks
#
# 环境变量:
#   WORLDSIM_EMAIL_ALLOWLIST      额外放行的邮箱 glob（空格分隔），叠加在内置白名单之上
#   WORLDSIM_LOCAL_FEATURE_SCAN   1（默认）= 同时扫描本项目私有部署特征；0 = 关闭
# =============================================================

set -u
set -f   # 关闭 glob 展开：邮箱/路径含特殊字符时不会被文件名展开干扰

# ---------- 配置 ----------
ALLOW_EMAIL="${WORLDSIM_EMAIL_ALLOWLIST:-}"
LOCAL_SCAN="${WORLDSIM_LOCAL_FEATURE_SCAN:-1}"

# 第 1 关：敏感文件名
SENSITIVE_FILES='(^|/)\.env$|(^|/)key\.txt$|\.pem$|\.p12$|(^|/)[^/]*\.key$|credentials\.json$|service-account.*\.json$'

# 第 2 关：形态判据 —— 通用凭证形态（开源后仍适用）
PATTERN='sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16}|BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY'
# 本项目私有部署特征（内网网段 / 私有部署根路径 / 运维账号形态）—— 开源后应关闭
LOCAL_PATTERN='(^|[^0-9])192\.168\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)|/vol2/1000/|TSX@[0-9]'
if [ "$LOCAL_SCAN" = "1" ]; then
  PATTERN="$PATTERN|$LOCAL_PATTERN"
fi

EMPTY_TREE=$(git hash-object -t tree /dev/null)

FAIL=0
REPORT=""
N_REF=0

# 邮箱白名单：GitHub 隐私地址 + 本地匿名占位；可用 WORLDSIM_EMAIL_ALLOWLIST 追加
is_allowed_email() {
  case "$1" in
    *@users.noreply.github.com|*@local) return 0 ;;
  esac
  if [ -n "$ALLOW_EMAIL" ]; then
    for _pat in $ALLOW_EMAIL; do
      case "$1" in $_pat) return 0 ;; esac
    done
  fi
  return 1
}

# ---------- 逐 ref 扫描 ----------
# $1 = 传给 git diff 的区间参数（可能含空格，故意不加引号以分词）
# $2 = 传给 git log 的区间参数
# $3 = 展示用标签
# 调用处一律以 </dev/null 调用，确保循环体内的子命令不会消费掉主循环的 stdin
scan_one() {
  _diff="$1"; _log="$2"; _desc="$3"
  echo "[pre-push] 扫描区间: $_desc"

  # 第 1 关：敏感文件名（扫全区间，不只 staged）
  # 排除 .githooks 自身：门禁脚本的 PATTERN 定义行含敏感字面量，否则会自匹配误报
  _bad=$(git diff --name-only $_diff -- . ':(exclude).githooks' 2>/dev/null | grep -E "$SENSITIVE_FILES")
  if [ -n "$_bad" ]; then
    REPORT="${REPORT}
[文件名] 区间内出现疑似敏感文件（$_desc）:
${_bad}"
    FAIL=1
  fi

  # 第 2 关：形态扫描（全区间）
  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks detect --source . --log-opts="$_log" --redact --verbose 2>&1; then
      REPORT="${REPORT}
[gitleaks] 检出疑似凭证（$_desc）"
      FAIL=1
    fi
  else
    _hits=$(git diff $_diff -- . ':(exclude).githooks' 2>/dev/null \
      | grep '^+' \
      | grep -v '^+++' \
      | grep -vE '^\+[[:space:]]*(#|//|\*|<!--|"""|--)' \
      | grep -nE "$PATTERN" \
      | head -20)
    if [ -n "$_hits" ]; then
      REPORT="${REPORT}
[形态] 命中敏感形态（$_desc）:
${_hits}"
      FAIL=1
    fi
  fi

  # 第 3 关：提交身份 —— author 与 committer 双字段，白名单外即拦截
  _mails=$(git log $_log --format='%ae%n%ce' 2>/dev/null | sort -u | grep -v '^$')
  echo "[pre-push] 提交身份: $(printf '%s' "$_mails" | tr '\n' ' ')"
  for _e in $_mails; do
    if ! is_allowed_email "$_e"; then
      REPORT="${REPORT}
[身份] 非白名单邮箱: $_e（$_desc）"
      FAIL=1
    fi
  done
}

# ---------- 主流程：解析 stdin 的真实推送对象 ----------
# git 传入格式（每行一个 ref）: <local ref> <local sha> <remote ref> <remote sha>
# 注意：主循环必须留在当前 shell（禁止放进管道/进程替换），否则 FAIL 会丢在子 shell 里
if [ -t 0 ]; then
  # 交互式运行（无 stdin 管道）→ 直接走兜底，避免 read 阻塞在终端
  echo "[pre-push] ⚠️  stdin 为终端（非 git 调用）→ 退化为「全部历史」扫描"
  scan_one "$EMPTY_TREE HEAD" "HEAD" "兜底 · 全部历史（无 stdin）" </dev/null
else
  while read -r _lref _lsha _rref _rsha; do
    [ -n "${_lsha:-}" ] || continue

    # 删除 ref（本地 sha 全零）→ 没有内容需要扫描
    case "$_lsha" in 0000000000000000000000000000000000000000)
      echo "[pre-push] 跳过（删除 ref）: ${_lref:-?}"
      continue ;;
    esac

    N_REF=$((N_REF + 1))
    case "${_rsha:-}" in
      ""|0000000000000000000000000000000000000000)
        # 新分支：远端尚不存在 → 与空树比较，覆盖该 ref 的全部历史
        scan_one "$EMPTY_TREE $_lsha" "$_lsha" "${_lref:-?} · 全部历史（新分支）" </dev/null ;;
      *)
        # 已存在分支：只扫本次新增的部分
        scan_one "$_rsha..$_lsha" "$_rsha..$_lsha" "$_rsha..$_lsha · ${_lref:-?}" </dev/null ;;
    esac
  done

  # stdin 为空（异常调用）→ 安全兜底：宁可多扫，不可漏扫
  if [ "$N_REF" -eq 0 ]; then
    echo "[pre-push] ⚠️  未收到推送对象（stdin 为空）→ 退化为「全部历史」扫描"
    scan_one "$EMPTY_TREE HEAD" "HEAD" "兜底 · 全部历史（空 stdin）" </dev/null
  fi
fi

# ---------- 第 4 关：本地身份静态自检（与「有无待推提交」解耦） ----------
CFG_EMAIL=$(git config user.email 2>/dev/null || true)
echo "[pre-push] 本地 user.email: ${CFG_EMAIL:-（未配置）}"
if [ -z "$CFG_EMAIL" ]; then
  REPORT="${REPORT}
[身份] git config user.email 未配置 —— 无法确定提交身份
  修复: git config user.email \"<你的 *@users.noreply.github.com 地址>\""
  FAIL=1
elif ! is_allowed_email "$CFG_EMAIL"; then
  REPORT="${REPORT}
[身份] 本地 user.email 不在白名单: $CFG_EMAIL
  修复: git config user.email \"<你的 *@users.noreply.github.com 地址>\"
  例外: 确需保留该地址 → export WORLDSIM_EMAIL_ALLOWLIST=\"$CFG_EMAIL\""
  FAIL=1
fi

# ---------- 判定 ----------
if [ "$FAIL" -eq 1 ]; then
  echo ""
  echo "=========================================="
  echo "  ❌ push 被 pre-push 门禁拦截"
  echo "=========================================="
  printf '%s\n' "$REPORT"
  echo ""
  echo "处理顺序（不能颠倒）："
  echo "  1. 真实凭证 → 先吊销/轮换；清理历史只是消疤，不是治疗"
  echo "  2. 误报 → 加入 .gitleaksignore 或调整正则"
  echo "  3. 紧急绕过 → git push --no-verify（CI / Push protection 会再拦）"
  echo ""
  exit 1
fi

echo "[pre-push] ✅ 通过"
exit 0
