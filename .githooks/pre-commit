#!/bin/sh
# =============================================================
# world-sim pre-commit 门禁（仓库内分发版）
#
# 相比旧版（.git/hooks/pre-commit，仅拒绝 .env 文件名）的升级：
#   1. 从「文件名黑名单」升级为「形态判据」（红线 #46：文件名黑名单是范畴错误）
#   2. 纳入版本控制（旧版在 .git/hooks/ 不入仓库，clone 即失效）
#
# 安装: git config core.hooksPath .githooks
# 绕过: git commit --no-verify（会被 pre-push / CI / Push protection 再拦）
# =============================================================

set -u

FAIL=0
REPORT=""

# ---------- 第 1 关：敏感文件名（沿用 ADR-0015） ----------
BAD_FILES=$(git diff --cached --name-only | grep -E \
  '(^|/)\.env$|(^|/)key\.txt$|\.pem$|\.p12$|(^|/)[^/]*\.key$|credentials\.json$|service-account.*\.json$')

if [ -n "$BAD_FILES" ]; then
  REPORT="${REPORT}\n[文件名] 疑似敏感文件:\n${BAD_FILES}"
  FAIL=1
fi

# ---------- 第 2 关：形态判据（核心，拦住硬编码密钥与内网地址） ----------
# 只扫本次新增行，并剔除常见注释行以降低误报（红线 #47）
PATTERN='sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16}|BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY|(^|[^0-9])192\.168\.[0-9]{1,3}\.[0-9]{1,3}([^0-9]|$)|/vol2/1000/|TSX@[0-9]'

# 排除 .githooks 自身：本脚本的 PATTERN 定义行含敏感字面量，否则会自匹配误报
HITS=$(git diff --cached -U0 -- . ':(exclude).githooks' 2>/dev/null \
  | grep '^+' \
  | grep -v '^+++' \
  | grep -vE '^\+[[:space:]]*(#|//|\*|<!--|"""|--)' \
  | grep -nE "$PATTERN" \
  | head -20)

if [ -n "$HITS" ]; then
  REPORT="${REPORT}\n[形态] 命中敏感形态（第 2 列为 diff 内行号）:\n${HITS}"
  FAIL=1
fi

# ---------- 判定 ----------
if [ "$FAIL" -eq 1 ]; then
  echo ""
  echo "=========================================="
  echo "  ❌ commit 被 pre-commit 门禁拦截"
  echo "=========================================="
  printf "%b\n" "$REPORT"
  echo ""
  echo "处理："
  echo "  1. 若为真实凭证 → 先吊销/轮换，再清理（删文件不等于清除历史）"
  echo "  2. 若为文档示例等误报 → 用 .gitleaksignore 或调整正则"
  echo "  3. 紧急绕过 → git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
