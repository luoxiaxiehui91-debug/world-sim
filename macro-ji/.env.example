# macro-ji（天玑 · 验证层）环境变量模板
# 最后更新：2026-09-10（开源实施计划 阶段 1，CHG-20260910T223700-world-deduction）
#
# 用法：复制为 .env 后填入真值；.env 不进 git。
# 对应容器：macro-scan-tianji-1 / macro-scan-tianji-cron-1

## 一、核心（必需）

# PostgreSQL 应用账号密码。与天枢/天璇共用 worldsim 库。
WORLDSIM_APP_PW=

# FRED API Key。用于校验输入的宏观时序。
# 申请：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ntfy 完整 URL（注意：天玑用的是整串 URL，不是 topic 名）。
# 格式：https://ntfy.sh/<你的告警频道名>
# 应与 macro-scan 的 NTFY_TOPIC 指向同一频道，便于统一接收。
NTFY_URL=

## 二、跨项目挂载（compose 插值用，必需）

# 天枢（macro-scan）目录的**绝对路径**。compose 会将该路径下的
# `data/`、`config/`、`知识库/` 挂载进天玑容器（知识库为只读）。
# 例：/path/to/world-sim/macro-scan
MACRO_SCAN_DIR=

## 三、高级配置（一般无需修改）

# 天玑数据目录（默认容器内路径）
TIANJI_DATA_DIR=

# 工作区路径（默认容器内路径）
OPENCLAW_WORKSPACE=

# 验证环节使用的模型
VERIFY_LLM_MODEL=
