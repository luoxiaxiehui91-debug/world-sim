# macro-sim（天璇 · 演化仿真）环境变量模板
# 最后更新：2026-09-10（开源实施计划 阶段 1，CHG-20260910T223700-world-deduction）
#
# 用法：复制为 .env 后填入真值；.env 不进 git。
# 注：本文件原含占位符真值（your_xxx_here）与一个已退役的旧 LLM 通道变量，本次一并规范化。

## 一、核心（必需）

# 硅基流动 API Key。天璇用 LLM 生成叙事与 Agent 推演。
# 控制台：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# PostgreSQL 应用账号密码。与天枢/天玑共用 worldsim 库。
WORLDSIM_APP_PW=

# ntfy 完整 URL（天璇同样用整串 URL）。
# 格式：https://ntfy.sh/<你的告警频道名>
NTFY_URL=

## 二、跨项目挂载（compose 插值用，必需）

# 天枢（macro-scan）目录的**绝对路径**。compose 会将该路径下的
# `data/` 与 `docs/仿真报告/` 挂载进天璇容器。
# 例：/path/to/world-sim/macro-scan
MACRO_SCAN_DIR=

## 三、高级配置（一般无需修改）

# 数据库地址（默认 worldsim-pg:5432）
WORLDSIM_PG_HOST=
WORLDSIM_PG_PORT=

# 仿真报告输出目录（默认容器内 /app/reports）
REPORT_DIR=

# 工作区路径
OPENCLAW_WORKSPACE=

# 天玑 LLM 试运行开关
TIANJI_LLM_PILOT=
